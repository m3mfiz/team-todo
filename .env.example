# team-todo environment
# Copy to .env and fill in real values. .env is git-ignored.

# Port the Fastify server listens on (3001 is taken by lab-booking in prod)
PORT=3002

# JWT secrets: >=32 bytes each, must differ from each other
JWT_SECRET=change-me-to-a-long-random-string-32b
JWT_REFRESH_SECRET=change-me-to-another-long-random-32b

# Seed admin credentials (required in production for db:seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Path to the SQLite database file (relative to repo root or absolute)
DB_PATH=./data/team-todo.db

# Timezone — keep in sync with lab-booking prod
TZ=Europe/Moscow

# Web Push (опционально: без ключей пуши выключены, приложение работает)
# Сгенерировать: node -e "const k=require('web-push').generateVAPIDKeys();console.log(k)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
